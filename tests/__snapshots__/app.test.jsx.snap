ontawesome.com%20License%20-%20https://fontawesome.com/license%20(Commercial%20License)%20Copyright%202023%20Fonticons,%20Inc.%20--%3e%3cpath%20d='M384%20336H192c-8.8%200-16-7.2-16-16V64c0-8.8%207.2-16%2016-16l140.1%200L400%20115.9V320c0%208.8-7.2%2016-16%2016zM192%20384H384c35.3%200%2064-28.7%2064-64V115.9c0-12.7-5.1-24.9-14.1-33.9L366.1%2014.1c-9-9-21.2-14.1-33.9-14.1H192c-35.3%200-64%2028.7-64%2064V320c0%2035.3%2028.7%2064%2064%2064zM64%20128c-35.3%200-64%2028.7-64%2064V448c0%2035.3%2028.7%2064%2064%2064H256c35.3%200%2064-28.7%2064-64V416H272v32c0%208.8-7.2%2016-16%2016H64c-8.8%200-16-7.2-16-16V192c0-8.8%207.2-16%2016-16H96V128H64z'/%3e%3c/svg%3e" alt="copy description"></div><button type="button" class="regenerar-btn" id="regenerar-btn">Regenerar observaciones automáticas</button><label class="filtro-frases" for="filtrar-frases-automaticas"><input type="checkbox" id="filtrar-frases-automaticas" checked="">Filtrar frases automáticas<small> (en Grupo, Sección y Descripción no aparecen las frases que la app ya agrega sola)</small></label><div class="variable-btn"><div class="btn-package col-class group-c"><h3>Grupo</h3><label class="focus" for="acumDefectos"><input type="radio" class="rad-c" name="group" id="acumDefectos" value="acumDefectos">Acumulación de defectos</label><label class="focus" for="direccion"><input type="radio" class="rad-c" name="group" id="direccion" value="direccion">Dirección</label><label class="focus" for="freno"><input type="radio" class="rad-c" name="group" id="freno" value="freno">Frenos</label><label class="focus" for="inspVisual"><input type="radio" class="rad-c" name="group" id="inspVisual" value="inspVisual">Inspección Visual</label><label class="focus" for="inspFosa"><input type="radio" class="rad-c" name="group" id="inspFosa" value="inspFosa">Inspección en Fosa</label><label class="focus" for="luces"><input type="radio" class="rad-c" name="group" id="luces" value="luces">Luces</label><label class="focus" for="ruedas"><input type="radio" class="rad-c" name="group" id="ruedas" value="ruedas">Ruedas</label><label class="focus" for="sistemaElectrico"><input type="radio" class="rad-c" name="group" id="sistemaElectrico" value="sistemaElectrico">Sistema Eléctrico</label><label class="focus" for="suspension"><input type="radio" class="rad-c" name="group" id="suspension" value="suspension">Suspensión</label><label class="focus" for="note"><input type="radio" name="group" id="note" class="rad-c" value="note"><b>*Notas adicionales</b></label></div><div class="btn-package col-class section-c"><h3>Sección</h3></div><div class="btn-package col-class description-c"><h3>Descripción</h3></div></div><h2 class="unlisted-defect"> Defecto no listado</h2><div class="unlisted-ctn"><label for="unlisted-defect" class="unlisted-defect">Seleccióne grupo al que pertenece la falla, luego el seleccione la opción "Otros" y finalmente escriba el defecto:</label><textarea name="unlisted-defect" id="unlisted-defect" class="unlisted-defect" cols="50" rows="3"></textarea><button class="send-btn">Agregar a la lista</button></div></form><table class="references print"><thead><tr class="reference-headers"></tr></thead><tbody><tr><td class="def-name minor">Leve</td><td class="def-col">Son defectos que no exigen una nueva inspección, pero que deberán subsanarse antes de la siguiente revisión.</td></tr><tr><td class="def-name orange">Moderado</td><td class="def-col">Exigen una nueva inspección sin cargo dentro de los sesenta (60) días corridos a partir de la verificación. Pasando el tiempo estipulado de “circulación originaria”, repetirá el pago original.<br><b>(*) Si el vencimiento coincide con domingo o feriado, el mismo se traslada al día habil inmediato anterior.</b></td></tr><tr><td class="def-name black"><b>Grave</b></td><td class="def-col">Exigen una nueva inspección atento a la gravedad que registra la unidad. Repetirá el pago original. Esta calificación no permite la circulación del vehículo. Una vez reparada la unidad se someterá a la segunda inspección.</td></tr></tbody><tfoot><tr></tr></tfoot></table></section></section></main></div>"`;

exports[`informe con .txt cargado > camión con VCW-112 (snapshot) 1`] = `"<div><header><h1>Informes Bubatec</h1></header><main><form class="form-radio" id="no-print"><main><div class="weightsTable"><table class="subgroup"><tbody><tr><td class="report-table table-cat">Año de fab</td><td class="report-table peligro">1974</td></tr><tr><td class="report-table table-cat">Alineción (m/km)</td><td class="report-table table-info">8.57</td></tr><tr><td class="report-table table-cat">Gases (%)</td><td class="report-table table-info"><div>0.25</div></td></tr><tr><td class="report-table table-cat">Combustible</td><td class="report-table table-info"></td></tr></tbody></table><table class="subgroup"><tbody><tr><td class="report-table table-cat" rowspan="2">Suspensión (%)</td><td class="report-table table-name">D Izq</td><td class="report-table table-name">D Der</td><td class="report-table table-name">T Izq</td><td class="report-table table-name">T Der</td></tr><tr><td class="report-table table-info">84.3</td><td class="report-table table-info">73.9</td><td class="report-table table-info">60.5</td><td class="report-table table-info">60.4</td></tr></tbody></table><table class="subgroup"><tbody><tr><td class="report-table table-cat" rowspan="2">Frenos (%)</td><td class="report-table table-name">Ren Del</td><td class="report-table table-name">Ren Tra</td><td class="report-table table-name">Dif Del</td><td class="report-table table-name">Dif Tra</td></tr><tr><td class="report-table table-info">48.87</td><td class="report-table table-info">60.89</td><td class="report-table table-info">7</td><td class="report-table table-info">2</td></tr></tbody></table><table class="subgroup"><tbody><tr><td class="report-table table-cat" rowspan="2">Peso (kg)</td><td class="report-table table-name">Total</td><td class="report-table table-name">Eje del</td><td class="report-table table-name">Eje tra</td></tr><tr><td class="report-table table-info">1952</td><td class="report-table table-info">930</td><td class="report-table table-info">1022</td></tr></tbody></table></div></main><div id="reset-btn" class="wrap-label reset-btn" for="reset-btn">Reiniciar todos los campos:<img class="reset-img" src="data:image/svg+xml,%3csvg%20xmlns='http://www.w3.org/2000/svg'%20viewBox='0%200%20512%20512'%20fill='%23FFFFFF'%3e%3c!--!%20Font%20Awesome%20Pro%206.1.2%20by%20@fontawesome%20-%20https://fontawesome.com%20License%20-%20https://fontawesome.com/license%20(Commercial%20License)%20Copyright%202022%20Fonticons,%20Inc.%20--%3e%3cpath%20d='M480%20256c0%20123.4-100.5%20223.9-223.9%20223.9c-48.86%200-95.19-15.58-134.2-44.86c-14.14-10.59-17-30.66-6.391-44.81c10.61-14.09%2030.69-16.97%2044.8-6.375c27.84%2020.91%2061%2031.94%2095.89%2031.94C344.3%20415.8%20416%20344.1%20416%20256s-71.67-159.8-159.8-159.8C205.9%2096.22%20158.6%20120.3%20128.6%20160H192c17.67%200%2032%2014.31%2032%2032S209.7%20224%20192%20224H48c-17.67%200-32-14.31-32-32V48c0-17.69%2014.33-32%2032-32s32%2014.31%2032%2032v70.23C122.1%2064.58%20186.1%2032.11%20256.1%2032.11C379.5%2032.11%20480%20132.6%20480%20256z'/%3e%3c/svg%3e" alt="reset"></div><h2>Tipo de vehículo</h2><div class="btn-package"><label class="btn-inside " for="Auto"><input type="radio" class="rad-c" name="tipo" id="Auto" value="Auto" checked="">Auto</label><label class="btn-inside " for="Camioneta"><input type="radio" class="rad-c" name="tipo" id="Camioneta" value="Camioneta">Camioneta</label><label class="btn-inside radio-checked" for="Camion"><input type="radio" class="rad-c" name="tipo" id="Camion" value="Camion">Camión</label><label class="btn-inside " for="Minibus"><input type="radio" class="rad-c" name="tipo" id="Minibus" value="Minibus">Colectivo</label><label class="btn-inside " for="Moto"><input type="radio" class="rad-c" name="tipo" id="Moto" value="Moto">Moto</label><div class="engine-and-size-ctn"><div class="engine-and-size"><label class="btn-inside transp-color" for="normal"><input type="radio" class="rad-c" name="rtoType" id="normal" value="normal" checked="">Normal</label></div><div class="engine-and-size"><label class="btn-inside transp-color" for="traPas"><input type="radio" class="rad-c" name="rtoType" id="traPas" value="traPas">Transporte de Pasajeros</label></div></div><div class="engine-and-size-ctn"><div class="engine-and-size"><label class="btn-inside" for="smallTruck"><input type="radio" class="rad-c" name="truckSize" id="smallTruck" value="smallTruck" checked="">Normal</label></div><div class="engine-and-size"><label class="btn-inside" for="bigTruck"><input type="radio" class="rad-c" name="truckSize" id="bigTruck" value="bigTruck">No susp. ni Rueda frenada</label></div></div></div><h3>Calcular fecha</h3><div class="btn-package"><label class="btn-inside Apto" for="Apto"><input type="radio" class="rad-c" name="dateCalcBtn" id="Apto" value="Apto" checked="">Apto</label><label class="btn-inside Condicional" for="Condicional"><input type="radio" class="rad-c" name="dateCalcBtn" id="Condicional" value="Condicional">Condicional</label><label class="btn-inside Rechazado" for="Rechazado"><input type="radio" class="rad-c" name="dateCalcBtn" id="Rechazado" value="Rechazado">Rechazado</label><label class="btn-inside SoloInforme" for="SoloInforme"><input type="radio" class="rad-c" name="dateCalcBtn" id="SoloInforme" value="SoloInforme">Solo informe</label><label class="btn-inside resultado-auto" for="resultado-automatico" title="Con algún defecto Grave: Rechazado. Con alguno Moderado: Condicional. Si no: Apto."><input type="checkbox" id="resultado-automatico" checked="">Automático</label> <span>Vigencia:</span><label class="btn-inside tooltip" for="2a"><span class="tooltiptext">7 Años o menos</span><input type="radio" class="rad-c" name="dueDateSelector" id="2a" value="2a" disabled="">2 A</label><label class="btn-inside tooltip" for="1a"><span class="tooltiptext">APTO</span><input type="radio" class="rad-c" name="dueDateSelector" id="1a" value="1a" checked="" disabled="">1 A</label><label class="btn-ins